{
  "name": "vidro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome lint . --files-ignore-unknown=true",
    "format": "biome format --write . --files-ignore-unknown=true",
    "vidro": "pnpm --filter @vidro/cli exec vidro"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.1.12"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "24.0.0",
    "turbo": "2.8.16",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  }
}
